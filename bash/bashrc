# Omarchy defaults (don't mess with these directly, just overwrite them here!)
source ~/.local/share/omarchy/default/bash/rc

# ============================================================================
# Custom Configuration
# ============================================================================

# Environment Variables
# export EDITOR=nvim
# export VISUAL=nvim

# Custom Aliases
# alias p='python3'
# alias v='nvim'
# alias g='git'
# alias d='docker'
# alias dc='docker-compose'

# Terminal aliases for large font
alias tl='alacritty-large'
alias term-large='alacritty-large'

# Bootstrap tmux sessions from the first interactive Alacritty shell without attaching.
# This starts tmux after the desktop/Wayland environment exists, instead of via login systemd.
if [[ $- == *i* && -z ${TMUX:-} && -z ${SSH_CONNECTION:-} && -z ${NO_AUTO_TMUX_BOOTSTRAP:-} ]]; then
  parent_comm=$(ps -o comm= -p "$PPID" 2>/dev/null | tr -d ' ')
  if [[ -n ${ALACRITTY_WINDOW_ID:-} || $parent_comm == alacritty ]]; then
    "$HOME/.config/tmux/scripts/bootstrap-sessions.sh" >/dev/null 2>&1 &
  fi
  unset parent_comm
fi

# Custom Functions
# mcd() {
#     mkdir -p "$1" && cd "$1"
# }

# Source API keys if they exist
[ -f "$HOME/.api_keys" ] && source "$HOME/.api_keys"

# Add any local bin directories to PATH
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/bin:$PATH"

# Custom prompt additions (if not using omarchy's prompt)
# PS1='[\u@\h \W]\$ '

# Source user-local tool environment if present
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# opencode
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"

# Nx completion (only available on machines with the FieldAI checkout)
NX_COMPLETION="$HOME/git/fai/fieldai-monorepo/tools/nx-completion/nx-completion.bash"
[ -f "$NX_COMPLETION" ] && source "$NX_COMPLETION"
unset NX_COMPLETION

. "$HOME/.local/share/../bin/env"

# Added by sonarqube-cli installer
export PATH="$HOME/.local/share/sonarqube-cli/bin:$PATH"
